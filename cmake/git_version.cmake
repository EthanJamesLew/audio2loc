# Writes a one-function source file reporting the version of this checkout,
# from git. Run at every build; rewrites the file only when the version
# changes, so a commit relinks instead of rebuilding.
#
#   cmake -DSOURCE_DIR=<repo> -DBASE=<project version> -DOUT=<file>
#         [-DPINNED=<any> -DFIXED=<version>] -P git_version.cmake
#
# With PINNED set (-DAUDIO2LOC_VERSION), FIXED is reported as is.
if(PINNED)
  set(version "${FIXED}")
else()
  include("${CMAKE_CURRENT_LIST_DIR}/version_from_tags.cmake")
  audio2loc_version_from_tags("${SOURCE_DIR}" "${BASE}" version release)
endif()
set(content "// Generated by cmake/git_version.cmake; do not edit.\n#include \"version.h\"\n\nconst char* pl::version_string() noexcept { return \"${version}\"; }\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT content STREQUAL old)
  file(WRITE "${OUT}" "${content}")
endif()
