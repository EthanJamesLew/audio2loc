# cmake/version_from_tags.cmake against real tags in a scratch repository.
#   cmake -DWORK=<empty dir to use> -P version_from_tags.cmake
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
include("${root}/cmake/version_from_tags.cmake")
find_package(Git REQUIRED)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/repo/cmake")
set(repo "${WORK}/repo")

function(git)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repo}" -c user.name=t -c user.email=t@t
      -c tag.gpgSign=false -c commit.gpgSign=false ${ARGN}
    OUTPUT_VARIABLE output OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE failed)
  if(failed)
    message(FATAL_ERROR "git ${ARGN} failed")
  endif()
  set(git_output "${output}" PARENT_SCOPE)
endfunction()
function(commit)
  file(APPEND "${repo}/file" "x\n")
  git(add -A)
  git(commit -q -m c)
  git(rev-parse --short=8 HEAD)
  set(sha "${git_output}" PARENT_SCOPE)
endfunction()
function(expect label build release)
  planeloc_version_from_tags("${repo}" 9.9.9 got_build got_release)
  if(NOT got_build STREQUAL "${build}" OR NOT got_release STREQUAL "${release}")
    message(FATAL_ERROR "${label}: got ${got_build} / ${got_release}, want ${build} / ${release}")
  endif()
endfunction()

git(init -q)
commit()
expect("no tag" "9.9.9-dev+g${sha}" 9.9.9)
git(tag v0.2.0)  # lightweight, as GitHub's release page makes it
expect("lightweight tag" 0.2.0 0.2.0)
file(APPEND "${repo}/file" "y\n")
expect("dirty on a tag" "0.2.0+g${sha}.dirty" 0.2.0)
git(checkout -q -- file)
commit()
commit()
expect("two commits on" "0.2.1-dev.2+g${sha}" 0.2.0)
file(APPEND "${repo}/file" "y\n")
expect("dirty past a tag" "0.2.1-dev.2+g${sha}.dirty" 0.2.0)
git(checkout -q -- file)
git(tag -a v0.3.0 -m annotated)
expect("annotated tag" 0.3.0 0.3.0)
commit()
git(tag v1.0.0-rc.1)
expect("pre-release tag" 1.0.0-rc.1 1.0.0)
commit()
expect("past a pre-release" "1.0.0-rc.1.dev.1+g${sha}" 1.0.0)
git(tag v1.0.0-rc.2)
git(tag v1.0.0)
expect("a release beats pre-releases on its commit" 1.0.0 1.0.0)
git(tag v1.0.1-rc.1)
git(tag v1.0.10)
git(tag v1.0.9)
expect("the highest tag on a commit" 1.0.10 1.0.10)
commit()
git(tag not-a-version)
expect("a tag of another form is ignored" "1.0.11-dev.1+g${sha}" 1.0.10)

# A patch tagged after a higher release is still that patch.
git(tag v0.9.1)
expect("a lower tag on this commit" 0.9.1 0.9.1)

# With no v, as a tag typed on GitHub's release page may be, and among tags with one.
commit()
git(tag 1.2.0)
expect("a tag without a v" 1.2.0 1.2.0)
commit()
expect("past a tag without a v" "1.2.1-dev.1+g${sha}" 1.2.0)
git(tag 1.3.0-rc.1)
expect("a pre-release without a v" 1.3.0-rc.1 1.3.0)
git(tag v1.3.0)
expect("a release beats a pre-release, v or not" 1.3.0 1.3.0)

# A source archive: no git, but `git archive` wrote down the tag.
file(WRITE "${repo}/.gitattributes" "cmake/archive_version.txt export-subst\n")
file(COPY "${root}/cmake/archive_version.txt" DESTINATION "${repo}/cmake")
commit()
git(tag v2.0.0)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repo}" archive --format=tar --prefix=out/
    -o "${WORK}/source.tar" HEAD RESULT_VARIABLE failed)
if(failed)
  message(FATAL_ERROR "git archive failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${WORK}/source.tar" WORKING_DIRECTORY "${WORK}")
planeloc_version_from_tags("${WORK}/out" 9.9.9 got_build got_release)
if(NOT got_build STREQUAL 2.0.0 OR NOT got_release STREQUAL 2.0.0)
  message(FATAL_ERROR "source archive: got ${got_build} / ${got_release}")
endif()
commit()
git(tag 3.0.0)
file(REMOVE_RECURSE "${WORK}/out")
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${repo}" archive --format=tar --prefix=out/
    -o "${WORK}/source.tar" HEAD RESULT_VARIABLE failed)
if(failed)
  message(FATAL_ERROR "git archive failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${WORK}/source.tar" WORKING_DIRECTORY "${WORK}")
planeloc_version_from_tags("${WORK}/out" 9.9.9 got_build got_release)
if(NOT got_build STREQUAL 3.0.0 OR NOT got_release STREQUAL 3.0.0)
  message(FATAL_ERROR "source archive without a v: got ${got_build} / ${got_release}")
endif()
